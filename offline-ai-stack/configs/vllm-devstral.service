[Unit]
Description=vLLM Devstral Small 2 (24B FP8)
After=network.target nvidia-persistenced.service

[Service]
Type=simple
User=cemilac
Environment=HF_HOME=/home/cemilac/offline-ai-stack/hf-cache
ExecStart=/home/cemilac/ai-stack/bin/vllm serve mistralai/Devstral-Small-2-24B-Instruct-2512 \
  --host 0.0.0.0 --port 8001 --max-model-len 131072 \
  --gpu-memory-utilization 0.28 --enable-auto-tool-choice \
  --tool-call-parser mistral
Restart=always
RestartSec=10
StandardOutput=append:/home/cemilac/offline-ai-stack/logs/vllm-devstral.log
StandardError=append:/home/cemilac/offline-ai-stack/logs/vllm-devstral.err

[Install]
WantedBy=multi-user.target
