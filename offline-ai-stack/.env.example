# Copy to .env and fill in. Used by docker-compose.yml and bring-up.sh.
# Get OAuth values from Forgejo: Settings > Applications > Create OAuth2 App
# with redirect URI http://localhost:8003/authorize.

FORGEJO_OAUTH_CLIENT=replace_me
FORGEJO_OAUTH_SECRET=replace_me

# Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=replace_me

# Optional: Langfuse (set after first launch via Langfuse UI)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
