# Copy to .env and fill in. Used by docker-compose.yml and bring-up.sh.
# Get OAuth values from Forgejo: Settings > Applications > Create OAuth2 App
# with redirect URI http://localhost:8003/authorize.

FORGEJO_OAUTH_CLIENT=replace_me
FORGEJO_OAUTH_SECRET=replace_me

# Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=replace_me

# Optional: Langfuse (set after first launch via Langfuse UI)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---------- Strict-offline telemetry opt-outs ----------
# scripts/offline-prep.sh writes the same set to /etc/environment for
# systemd; keeping them here makes docker-compose pick them up too.

# Universal markers
DO_NOT_TRACK=1
TELEMETRY_DISABLED=1
SCARF_NO_ANALYTICS=true

# Local-only inference: never accidentally hit api.openai.com or anthropic.com
OPENAI_API_KEY=local
OPENAI_API_BASE=http://localhost:8000/v1
ANTHROPIC_API_KEY=

# LangChain / LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# CrewAI's own telemetry (langtrace integration on by default in some versions)
CREWAI_TELEMETRY_OPT_OUT=true
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# Aider, OpenHands, promptfoo
AIDER_ANALYTICS=false
AIDER_ANALYTICS_DISABLE=1
PROMPTFOO_DISABLE_TELEMETRY=1

# ChromaDB → PostHog
ANONYMIZED_TELEMETRY=false

# HuggingFace Hub telemetry (separate from OFFLINE flag — see systemd units)
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1

# vLLM
VLLM_NO_USAGE_STATS=1
VLLM_DO_NOT_TRACK=1

# LlamaIndex / posthog
LLAMA_INDEX_TELEMETRY_DISABLED=true
LLAMA_INDEX_ANALYTICS_DISABLED=true
POSTHOG_DISABLED=true

# pip — skip the version check call at every invocation
PIP_DISABLE_PIP_VERSION_CHECK=1
